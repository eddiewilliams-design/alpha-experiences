{
  "rewrites": [
    { "source": "/lul", "destination": "/lul.html" },
    { "source": "/auth/login", "destination": "/auth/login.html" },
    { "source": "/trips", "destination": "/trips.html" },
    { "source": "/trips/:tripId/submit", "destination": "/submit.html" },
    { "source": "/trips/:tripId", "destination": "/trip-detail.html" },
    { "source": "/gallery", "destination": "/gallery.html" },
    { "source": "/lounge", "destination": "/lounge.html" },
    { "source": "/lounge/pick", "destination": "/lounge-pick.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/trips/new", "destination": "/admin-trip-editor.html" },
    { "source": "/admin/trips/:tripId/edit", "destination": "/admin-trip-editor.html" },
    { "source": "/admin/registrations", "destination": "/admin-registrations.html" },
    { "source": "/admin/submissions", "destination": "/admin-submissions.html" },
    { "source": "/admin/access", "destination": "/admin-access.html" },
    { "source": "/admin/suggestions", "destination": "/admin-suggestions.html" },
    { "source": "/admin/notifications", "destination": "/admin-notifications.html" },
    { "source": "/admin/lounge", "destination": "/admin-lounge-sessions.html" },
    { "source": "/admin/lounge/types", "destination": "/admin-lounge-types.html" },
    { "source": "/admin/lounge/passes", "destination": "/admin-lounge-passes.html" },
    { "source": "/admin/lounge/attendance", "destination": "/admin-lounge-attendance.html" },
    { "source": "/admin/lounge/copy", "destination": "/admin-lounge-copy.html" },
    { "source": "/auth/google", "destination": "/api/auth/google" },
    { "source": "/auth/callback", "destination": "/api/auth/callback" },
    { "source": "/auth/me", "destination": "/api/auth/me" },
    { "source": "/auth/logout", "destination": "/api/auth/logout" }
  ],
  "crons": [
    {
      "path": "/api/cron/lul-expiry-reminders",
      "schedule": "0 14 * * *"
    }
  ]
}
